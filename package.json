{
  "name": "expense-clone",
  "version": "1.0.0",
  "main": "index.ts",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.27",
    "expo-application": "~57.0.3",
    "expo-auth-session": "~57.0.14",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-print": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-tracking-transparency": "~57.0.2",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "^17.2.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:apk": "npx --yes eas-cli build --platform android --profile apk",
    "build:ios": "npx --yes eas-cli build --platform ios --profile ios",
    "build:prod": "npx --yes eas-cli build --platform all --profile production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'tests/**/*.test.ts'",
    "verify": "npm run lint && npm run typecheck && npm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "private": true
}
